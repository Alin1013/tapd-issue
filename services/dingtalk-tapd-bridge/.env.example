# Python Bridge 运行目录由 systemd 的 WorkingDirectory 固定为 /var/lib/dingtalk-tapd。
# 真实环境文件应放在 /etc/dingtalk-tapd-listen.env，并设置为 root:dingtalkbot 0640。

# DWS CLI 必须在 dingtalkbot 用户下完成登录；没有 profile 时使用当前 profile。
DWS_EXECUTABLE=/usr/local/bin/dws
DWS_PROFILE=

# Python Bridge 使用 REST 时需要 TAPD OAuth token 或 Basic 账号密码。
# 长期服务建议使用独立、最小权限的 TAPD 账号；不要把真实值提交到仓库。
TAPD_BACKEND=rest
TAPD_API_BASE_URL=https://api.tapd.cn
TAPD_BASE_URL=https://www.tapd.cn
TAPD_ACCESS_TOKEN=
TAPD_CLIENT_ID=
TAPD_CLIENT_SECRET=
TAPD_API_USER=
TAPD_API_PASSWORD=

# 自动建单目标和业务默认值；目标群 ID 必须使用稳定 openConversationId。
DINGTALK_TAPD_GROUPS='[{"id":"cid3SbKZNiotRpk9RdlluSUSA==","name":"DeepWorks 产品交流群"},{"id":"cidfKBMe69X0qnHeBdQ9h7YNw==","name":"测试机器人"}]'
DINGTALK_TAPD_WORKSPACE_ID=57379524
DINGTALK_TAPD_OWNER=雷艾琳
DINGTALK_TAPD_DEVELOPER=
DINGTALK_TAPD_TESTER=雷艾琳
DINGTALK_TAPD_TITLE_PREFIX=【企业知识中心—用户反馈】

# listen 不要求 @；正文或 OCR 命中企业知识中心主题才会写入 TAPD。
DINGTALK_TAPD_STATE_DB=.dingtalk-tapd/state.sqlite3
DINGTALK_TAPD_ATTACHMENT_DIR=.dingtalk-tapd/attachments
DINGTALK_TAPD_READY_TIMEOUT=30
DINGTALK_TAPD_OCR_COMMAND=

# 仅在需要覆盖默认模块分工时填写 JSON；留空使用仓库内置规则。
DINGTALK_TAPD_RESPONSIBILITY_WHITELIST=
