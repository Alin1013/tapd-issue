PORT=3000

# Must be an HTTPS URL reachable by DingTalk. Local PoC can use a tunnel URL.
PUBLIC_BASE_URL=https://your-public-host.example.com
MEDIA_DIR=/var/lib/dingtalk-tapd-bug-bot/media

# TAPD project and credentials.
TAPD_WORKSPACE_ID=10158231
TAPD_API_BASE_URL=https://api.tapd.cn
TAPD_ACCESS_TOKEN=
TAPD_CLIENT_ID=
TAPD_CLIENT_SECRET=
# Basic Auth is only a compatibility fallback; prefer TAPD OAuth above.
TAPD_API_USER=
TAPD_API_PASSWORD=
# TAPD /files/upload_attachment target. `bug` creates a standard Bug attachment.
# Set the custom field only when a Bug custom-field attachment is intended.
TAPD_ATTACHMENT_TYPE=bug
TAPD_ATTACHMENT_CUSTOM_FIELD=
TAPD_ATTACHMENT_OWNER=
# 自动入口默认分析后直接创建 Bug；设为 false 可回退为草稿确认流程。
TAPD_AUTO_CREATE_BUGS=true
# 最终写入 TAPD 的标题前缀；默认统一为企业知识中心用户反馈。
TAPD_BUG_TITLE_PREFIX=【企业知识中心—用户反馈】
# 未命中责任白名单时的兜底字段；测试人当前固定为雷艾琳。
TAPD_DEFAULT_OWNER=雷艾琳
TAPD_DEFAULT_DEVELOPER=
TAPD_DEFAULT_TESTER=雷艾琳
# 数组规则示例：[{"match":["登录","账号"],"current_owner":"处理人姓名或账号","de":"开发人姓名或账号"}]
# 也支持对象写法：{"登录":{"current_owner":"处理人","de":"开发人"},"default":{"current_owner":"默认处理人"}}
TAPD_RESPONSIBILITY_WHITELIST=

# DingTalk enterprise robot HTTP callback verification.
DINGTALK_CLIENT_SECRET=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_ROBOT_CODE=
DINGTALK_ACCESS_TOKEN=
DINGTALK_CARD_TEMPLATE_ID=
DINGTALK_CARD_CALLBACK_ROUTE_KEY=
DINGTALK_CARD_CALLBACK_SECRET=

# Shared HMAC secret for the local Python DWS listener -> /api/agent/events bridge.
# Keep this value identical to DINGTALK_TAPD_AGENT_SECRET on the listener host.
AGENT_INGEST_SECRET=

# Signs short-lived H5 form state and temporarily holds the session webhook.
# Required for a production deployment. Use a random 32+ character value.
DINGTALK_FORM_SECRET=

# Bug Agent. Set the model ID available in your API account.
ENABLE_BUG_AGENT=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6
OPENAI_API_MODE=auto
OPENAI_TIMEOUT_MS=90000
OPENAI_MAX_OUTPUT_TOKENS=1800

# Optional: set true to run the complete flow without calling TAPD.
MOCK_TAPD=false

# Optional default values.
TAPD_DEFAULT_PRIORITY_LABEL=中
TAPD_DEFAULT_ITERATION=企业知识中心9月
TAPD_DEFAULT_VERSION_REPORT=v1.3.0
TAPD_DEFAULT_MODULE=企业知识中心
TAPD_DEFAULT_TESTMODE=手工测试
TAPD_DEFAULT_ITERATION_BUG=是
# 缺陷根源默认值；留空时由模型从 TAPD 候选中判断。
TAPD_DEFAULT_SOURCE=
TAPD_BUG_URL_TEMPLATE=https://www.tapd.cn/{workspace_id}/bugtrace/bugs/view?bug_id={id}
